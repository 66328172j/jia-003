<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fc.v2.mapper.auto.TSensorMapper">
    
    <resultMap type="com.fc.v2.model.auto.TSensor" id="TSensorResult">
        <result property="id"    column="id"    />
        <result property="plotId"    column="plot_id"    />
        <result property="code"    column="code"    />
        <result property="depth"    column="depth"    />
        <result property="location"    column="location"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectTSensorVo">
        select id, plot_id, code, depth, location, del_flag, create_by, create_time from t_irri_sensor
    </sql>

</mapper>